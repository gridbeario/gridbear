# ============================================================
# GridBear Environment Configuration
# ============================================================
# Copy to .env and fill in required values before starting.
# Generate secrets with: openssl rand -base64 24
# ============================================================

# --- REQUIRED ---------------------------------------------------

# PostgreSQL password (shared by all database users)
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Internal API secret for UI <-> gridbear communication
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- CHANNEL TOKENS (at least one required) ---------------------

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Discord bot token from Developer Portal
DISCORD_TOKEN=

# --- OPTIONAL: AI Provider Keys ---------------------------------

# Anthropic API key (required only for Claude API backend)
ANTHROPIC_API_KEY=

# Claude model: sonnet (default), opus (more capable), haiku (fastest)
CLAUDE_MODEL=sonnet

# --- REQUIRED in non-dev deploys: Public URL & Auth -------------
#
# The three variables below default to localhost for local development.
# BEFORE exposing GridBear to a LAN IP, a hostname, or the internet you
# MUST change all three to match the public URL — otherwise:
#   - Artifact / share links emitted by the bot point at "localhost"
#     and are unopenable from anyone else's device
#   - OAuth2 callback URLs mismatch (login / integrations break)
#   - WebAuthn (FIDO2 passkeys) refuses to register or authenticate
#     because the relying-party ID doesn't match the origin
#
# The admin dashboard emits a persistent warning until these are
# consistent with the request's real host.

# Public URL where the UI is accessible — the SAME URL operators
# and external users will use to reach the bot. Example for a LAN
# deploy:  http://192.168.20.25:8088   or   https://bot.example.com
GRIDBEAR_BASE_URL=http://localhost:8088

# WebAuthn relying party ID — the domain (NO scheme, NO port).
# For http://192.168.20.25:8088  →  WEBAUTHN_RP_ID=192.168.20.25
# For https://bot.example.com     →  WEBAUTHN_RP_ID=bot.example.com
WEBAUTHN_RP_ID=localhost

# WebAuthn origin — MUST be identical to GRIDBEAR_BASE_URL above,
# scheme included.
WEBAUTHN_ORIGIN=http://localhost:8088

# --- OPTIONAL: Platform Authorization --------------------------

# Comma-separated IDs and/or @usernames per channel
# Empty = no restriction (all users authorized)
TELEGRAM_AUTHORIZED_USERS=
DISCORD_AUTHORIZED_USERS=

# --- OPTIONAL: Runtime Tuning -----------------------------------

LOG_LEVEL=INFO
SESSION_TTL_HOURS=4
CLAUDE_TIMEOUT_SECONDS=120

# Admin/portal login sessions use sliding expiration: each authenticated
# request resets the inactivity window; the session is only killed after
# INACTIVITY_HOURS without traffic, and never lives longer than MAX_DAYS
# from the moment of login (hard cap, protects against cookie theft).
GRIDBEAR_SESSION_INACTIVITY_HOURS=72
GRIDBEAR_SESSION_MAX_DAYS=30

# Verbose logging for agent communications (prompts, responses)
VERBOSE_AGENT_LOG=false

# --- OPTIONAL: Executor (dev-projects plugin) -------------------

# Token for sandboxed code executor (generate with: openssl rand -hex 32)
EXECUTOR_TOKEN=

# Docker socket group GID (run: getent group docker | cut -d: -f3)
DOCKER_GID=983

# --- OPTIONAL: Additional Plugin Directories --------------------

# Comma-separated paths to extra plugin directories
EXTRA_PLUGINS_DIRS=
