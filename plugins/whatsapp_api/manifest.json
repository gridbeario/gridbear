{
  "name": "whatsapp_api",
  "version": "0.1.0",
  "description": "WhatsApp channel via Meta Cloud API (graph.facebook.com)",
  "type": "channel",
  "entry_point": "adapter.py",
  "class_name": "WhatsAppMetaChannel",
  "instantiation": "per-agent",
  "provides": "whatsapp_api",
  "config_schema": {
    "app_secret": {
      "type": "secret",
      "description": "Meta app secret for webhook HMAC validation",
      "required": true
    },
    "verify_token": {
      "type": "secret",
      "description": "Token for webhook verification handshake",
      "required": true
    }
  },
  "conflicts": ["whatsapp_evolution"],
  "dependencies": {
    "required": ["sessions", "attachments"],
    "optional": ["memory", "adversarial", "image", "transcription", "tts"]
  }
}
